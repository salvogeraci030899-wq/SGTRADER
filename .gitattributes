# Dati personali: cifrati nel repository (repository pubblico), in chiaro nei workflow.
# Filtro e unione: tools/datacrypt.py, configurati dal passo "Dati cifrati" (.github/actions/data-key).
# Senza la chiave DATA_KEY restano in chiaro come prima.
automation.json filter=ptenc merge=ptenc
live_trades.json filter=ptenc merge=ptenc
paper_trades.json filter=ptenc merge=ptenc
agent_state.json filter=ptenc merge=ptenc
alerts_state.json filter=ptenc merge=ptenc
quick_state.json filter=ptenc merge=ptenc
equity_history.json filter=ptenc merge=ptenc
# File di stato che crescono riga per riga: se due workflow salvano insieme si tengono le righe di entrambi
# (track_record.py scarta poi i doppioni per id).
*.jsonl merge=union
# Registro degli eventi: cresce riga per riga; se due workflow salvano insieme si tengono le righe di
# entrambi (unione per righe anche quando è cifrato); l'app scarta i doppioni per id.
events/*.jsonl filter=ptenc merge=ptenc
